        function updateAgentUI(active) {
            agentActive = active;
            document.getElementById('agent-not-spawned').style.display = active ? 'none' : 'block';
            document.getElementById('agent-spawned').style.display = active ? 'block' : 'none';
        }
        
        function updateAgentDisplay(agent) {
            if (!agent) return;
            
            document.getElementById('agent-name').textContent = agent.name || 'Prime Agent';
            document.getElementById('agent-state').textContent = agent.status || 'Active';
            document.getElementById('agent-budget-display').textContent = '$' + (agent.value || 0).toFixed(0);
            document.getElementById('agent-trust-display').textContent = ((agent.trust || 0) * 100).toFixed(0) + '%';
            document.getElementById('agent-tx-display').textContent = agent.successful_transactions || 0;
            document.getElementById('agent-last-action').textContent = agent.last_action?.action || '-';
            
            // Update progress bars
            const budgetPercent = Math.min(100, (agent.value / 5000) * 100);
            document.getElementById('agent-budget-bar').style.width = budgetPercent + '%';
            document.getElementById('agent-trust-bar').style.width = ((agent.trust || 0) * 100) + '%';
        }
        
        // Override runSimulation to update agent display
        const originalRunSimulation = runSimulation;
        runSimulation = async function(steps) {
            try {
                const response = await fetch('/api/simulate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ steps })
                });
                const data = await response.json();
                updateVisualization(data.state);
                
                // Update entropy metrics
                if (data.entropy) {
                    document.getElementById('stat-temp').textContent = data.entropy.temperature?.toFixed(3) || '0';
                }
                
                // Update agent status
                if (data.agent) {
                    updateAgentUI(true);
                    updateAgentDisplay(data.agent);
                    document.getElementById('stat-agent').textContent = 
                        `${data.agent.name} ($${data.agent.value?.toFixed(0)})`;
                    document.getElementById('stat-agent').className = 'stat-value success';
                    document.getElementById('agent-toggle').classList.add('active');
                } else {
                    // No agent active
                    updateAgentUI(false);
                    document.getElementById('stat-agent').textContent = 'None';
                    document.getElementById('stat-agent').className = 'stat-value';
                    document.getElementById('agent-toggle').classList.remove('active');
                }
                
                // Check asymmetry
                checkAsymmetry();
                
                // Show instabilities
                if (data.instabilities && data.instabilities.length > 0) {
                    console.warn('Instabilities detected:', data.instabilities);
                }
                
                // Record metrics if recording
                if (metricsRecording) {
                    recordMetrics();
                }
            } catch (error) {
                console.error('Simulation failed:', error);
            }
        };
        
        // Experiment functions
        async function runExperiment(experimentName) {
            try {
                const response = await fetch(`/api/experiment/setup?experiment=${experimentName}`, { method: 'POST' });
                const data = await response.json();
                
                if (data.success) {
                    console.log(`Experiment ${experimentName} setup:`, data);
                    alert(`Experiment: ${data.experiment}\n\n${data.description}\n\nExpected: ${data.expected}`);
                    
                    // Update UI toggles
                    if (experimentName === 'zero_agent') {
                        document.getElementById('agent-toggle').classList.remove('active');
                        document.getElementById('entropy-quick-toggle').classList.add('active');
                        updateAgentUI(false);
                    } else if (experimentName === 'stress_test' || experimentName === 'long_run') {
                        document.getElementById('agent-toggle').classList.add('active');
                        updateAgentUI(true);
                    }
                    
                    // Reload state
                    await loadState();
                } else {
                    alert('Experiment setup failed: ' + data.message);
                }
            } catch (error) {
                console.error('Experiment setup failed:', error);
            }
        }
        
        // Quick toggles for experiments
        async function toggleAgentQuick() {
            const toggle = document.getElementById('agent-toggle');
            const isActive = toggle.classList.contains('active');
            
            if (isActive) {
                // Kill agent
                await fetch('/api/agent/kill', { method: 'POST' });
                toggle.classList.remove('active');
                updateAgentUI(false);
            } else {
                // Spawn agent
                await fetch('/api/agent/spawn?budget=5000&action_probability=0.3', { method: 'POST' });
                toggle.classList.add('active');
                updateAgentUI(true);
            }
        }
        
        async function toggleEntropyQuick() {
            const toggle = document.getElementById('entropy-quick-toggle');
            const isActive = toggle.classList.contains('active');
            
            entropyEnabled = !isActive;  // Track for quiescence
            await fetch(`/api/entropy/toggle?enabled=${entropyEnabled}`, { method: 'POST' });
            toggle.classList.toggle('active');
            
            // Wake up simulation if entropy turned on
            if (entropyEnabled) {
                quiescentTicks = 0;
                isQuiescent = false;
                renderFPS = 60;
            }
        }
        
        async function updateMemoryCost() {
            const cost = parseFloat(document.getElementById('memory-cost').value);
            document.getElementById('memory-cost-value').textContent = cost.toFixed(1) + 'x';
            
            await fetch(`/api/memory/cost?cost_multiplier=${cost}`, { method: 'POST' });
        }
        
        // Metrics recording for long-run experiments
        let metricsRecording = false;
        let metricsHistory = [];
        
        function toggleMetricsRecording() {
            metricsRecording = !metricsRecording;
            
            if (metricsRecording) {
                document.getElementById('metrics-record-text').textContent = '⏹ Stop Recording';
                document.getElementById('metrics-status').textContent = 'Recording...';
                metricsHistory = [];
            } else {
                document.getElementById('metrics-record-text').textContent = '📊 Start Recording';
                document.getElementById('metrics-status').textContent = 'Stopped';
            }
        }
        
        async function recordMetrics() {
            try {
                const response = await fetch('/api/metrics/record', { method: 'POST' });
                const data = await response.json();
                
                if (data.success) {
                    metricsHistory.push(data.record);
                    document.getElementById('metrics-count').textContent = metricsHistory.length + ' records';
                    
                    // Draw chart
                    drawAsymmetryChart();
                }
            } catch (error) {
                console.error('Failed to record metrics:', error);
            }
        }
        
        function drawAsymmetryChart() {
            const canvas = document.getElementById('asymmetry-canvas');
            const ctx = canvas.getContext('2d');
            
            // Set canvas size
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            
            // Clear
            ctx.fillStyle = '#111';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            if (metricsHistory.length < 2) return;
            
            // Draw asymmetry line
            const maxAsym = Math.max(...metricsHistory.map(m => m.asymmetry_score), 0.5);
            const step = canvas.width / (metricsHistory.length - 1);
            
            ctx.beginPath();
            ctx.strokeStyle = '#00d4ff';
            ctx.lineWidth = 2;
            
            metricsHistory.forEach((m, i) => {
                const x = i * step;
                const y = canvas.height - (m.asymmetry_score / maxAsym) * canvas.height;
                
                if (i === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });
            
            ctx.stroke();
            
            // Draw threshold line at 0.2 (emergence threshold)
            const thresholdY = canvas.height - (0.2 / maxAsym) * canvas.height;
            ctx.beginPath();
            ctx.strokeStyle = '#44ff88';
            ctx.lineWidth = 1;
            ctx.setLineDash([5, 5]);
            ctx.moveTo(0, thresholdY);
            ctx.lineTo(canvas.width, thresholdY);
            ctx.stroke();
            ctx.setLineDash([]);
        }
        
        // Draggable panels functionality
        let draggedPanel = null;
        let dragOffset = { x: 0, y: 0 };
        
        function startDrag(e, panelId) {
            if (e.target.classList.contains('panel-btn')) return;
            e.preventDefault();
            draggedPanel = document.getElementById(panelId);
            const rect = draggedPanel.getBoundingClientRect();
            dragOffset.x = e.clientX - rect.left;
            dragOffset.y = e.clientY - rect.top;
            draggedPanel.style.zIndex = 200;
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
        }
        
        function onDrag(e) {
            if (!draggedPanel) return;
            const x = e.clientX - dragOffset.x;
            const y = e.clientY - dragOffset.y;
            draggedPanel.style.left = Math.max(0, Math.min(window.innerWidth - 100, x)) + 'px';
            draggedPanel.style.top = Math.max(0, Math.min(window.innerHeight - 50, y)) + 'px';
            draggedPanel.style.right = 'auto';
            draggedPanel.style.bottom = 'auto';
            draggedPanel.style.transform = 'none';
        }
        
        function stopDrag() {
            if (draggedPanel) draggedPanel.style.zIndex = 100;
            draggedPanel = null;
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
        }
        
        function hidePanel(panelId) {
            const panel = document.getElementById(panelId);
            if (panel) panel.style.display = 'none';
        }
        
        function minimizePanel(panelId) {
            const panel = document.getElementById(panelId);
            if (panel) panel.classList.toggle('minimized');
        }
        
        // Initialize
        init();
    </script>
</body>
</html>
