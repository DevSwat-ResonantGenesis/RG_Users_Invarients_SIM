        async function killAllAgents() {
            try {
                const response = await fetch('/api/agents/kill_all', { method: 'POST' });
                const data = await response.json();
                
                if (data.success) {
                    agentActive = false;
                    updateAgentUI(false);
                    document.getElementById('agent-toggle').classList.remove('active');
                    alert(`Killed ${data.killed} agents`);
