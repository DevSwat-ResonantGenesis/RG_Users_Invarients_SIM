                    })
                });
                const data = await response.json();
                updateVisualization(data.state);
                
                console.log('Galaxy created:', data.nodes, 'nodes,', data.edges, 'edges');
                console.log('Agent enabled:', data.agent_enabled);
                console.log('Entropy enabled:', data.entropy_enabled);
                
                // Run initial simulation to spread out
                await runSimulation(100);
            } catch (error) {
                console.error('Failed to generate galaxy:', error);
            }
            
            document.getElementById('loading').style.display = 'none';
        }
        
        async function perturbation() {
            try {
                const response = await fetch('/api/entropy/perturbation?magnitude=2.0', { method: 'POST' });
                const data = await response.json();
                console.log('Perturbation event:', data.event);
                
                // Wake up from quiescence after perturbation
                quiescentTicks = 0;
                isQuiescent = false;
                renderFPS = 60;
                
                await runSimulation(10);
            } catch (error) {
                console.error('Perturbation failed:', error);
            }
        }
        
        function updateSimSpeed() {
            simSpeed = parseInt(document.getElementById('sim-speed').value);
            document.getElementById('sim-speed-value').textContent = simSpeed;
        }
        
        async function runSimulation(steps) {
            try {
                const response = await fetch('/api/simulate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ steps })
                });
                const data = await response.json();
                updateVisualization(data.state);
                
                // Update entropy metrics
                if (data.entropy) {
                    document.getElementById('stat-temp').textContent = data.entropy.temperature?.toFixed(3) || '0';
                }
                
                // Update agent status
                if (data.agent) {
                    document.getElementById('stat-agent').textContent = 
                        `${data.agent.name} ($${data.agent.value?.toFixed(0)})`;
                    document.getElementById('stat-agent').className = 'stat-value success';
                }
                
                // Check asymmetry
                checkAsymmetry();
                
                // Show instabilities
                if (data.instabilities && data.instabilities.length > 0) {
                    console.warn('Instabilities detected:', data.instabilities);
                }
            } catch (error) {
                console.error('Simulation failed:', error);
            }
        }
        
        function toggleAutoSimulate() {
            autoSimulate = !autoSimulate;
            
            if (autoSimulate) {
                document.getElementById('auto-sim-text').textContent = '⏸ Stop Simulation';
                // Use adaptive interval based on quiescence
                startAdaptiveSimulation();
            } else {
                document.getElementById('auto-sim-text').textContent = '⏯ Auto Simulate';
                clearInterval(autoSimInterval);
            }
        }
        
        function startAdaptiveSimulation() {
            clearInterval(autoSimInterval);
            
            const tick = async () => {
                if (!autoSimulate) return;
                
                // Skip simulation if quiescent and entropy is off
                if (isQuiescent && !entropyEnabled) {
                    // Sleep mode - check every 2 seconds instead of 100ms
                    autoSimInterval = setTimeout(tick, 2000);
                    return;
                }
                
                await runSimulation(simSpeed);
                
                // Adaptive interval: slower when quiescent
                const interval = isQuiescent ? 500 : 100;
                autoSimInterval = setTimeout(tick, interval);
            };
            
            tick();
        }
        
        async function resetUniverse() {
            try {
                await fetch('/api/reset', { method: 'POST' });
                
                // Clear visualization with proper memory cleanup
                for (const mesh of Object.values(nodeMeshes)) {
                    scene.remove(mesh);
                    mesh.geometry.dispose();
                    mesh.material.dispose();
                }
                for (const line of Object.values(edgeLines)) {
                    scene.remove(line);
                    line.geometry.dispose();
                    line.material.dispose();
                }
                nodeMeshes = {};
                edgeLines = {};
                nodes = [];
                edges = [];
                
                // Reset quiescence state
                lastPositions = {};
                quiescentTicks = 0;
                isQuiescent = false;
                renderFPS = 60;
                
                updateStats({ node_count: 0, edge_count: 0, total_mass: 0, total_value: 0, average_trust: 0, average_temperature: 0, invariant_violations: 0 });
            } catch (error) {
                console.error('Reset failed:', error);
            }
        }
        
        async function updatePhysics() {
            const gravity = parseFloat(document.getElementById('gravity').value);
            const repulsion = parseFloat(document.getElementById('repulsion').value);
            const damping = parseFloat(document.getElementById('damping').value);
            
            document.getElementById('gravity-value').textContent = gravity.toFixed(2);
            document.getElementById('repulsion-value').textContent = repulsion;
            document.getElementById('damping-value').textContent = damping.toFixed(2);
            
            try {
                await fetch('/api/physics/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        gravity_constant: gravity,
                        repulsion_constant: repulsion,
                        damping: damping
                    })
                });
            } catch (error) {
                console.error('Failed to update physics:', error);
            }
        }
        
        function updateVisualization(data) {
            nodes = data.nodes || [];
            edges = data.edges || [];
            
            // Check quiescence after each update
            checkQuiescence();
            
            // Update/create node meshes
            for (const node of nodes) {
                if (nodeMeshes[node.id]) {
                    // Update position
                    nodeMeshes[node.id].position.set(
                        node.position?.x || 0,
                        node.position?.y || 0,
                        node.position?.z || 0
                    );
                } else {
                    // Create new mesh
                    const size = Math.max(3, Math.min(20, (node.mass || 1) * 3));
                    const geometry = new THREE.SphereGeometry(size, 16, 16);
                    const color = nodeColors[node.type] || 0xffffff;
                    const material = new THREE.MeshPhongMaterial({
                        color: color,
                        emissive: color,
                        emissiveIntensity: 0.2,
                        transparent: true,
                        opacity: 0.9
                    });
                    
                    const mesh = new THREE.Mesh(geometry, material);
                    mesh.position.set(
                        node.position?.x || 0,
                        node.position?.y || 0,
                        node.position?.z || 0
                    );
                    mesh.userData.nodeId = node.id;
                    mesh.userData.baseScale = 1;
                    
                    scene.add(mesh);
                    nodeMeshes[node.id] = mesh;
                }
            }
            
            // Remove old meshes with proper disposal
            for (const id of Object.keys(nodeMeshes)) {
                if (!nodes.find(n => n.id === id)) {
                    const mesh = nodeMeshes[id];
                    scene.remove(mesh);
                    mesh.geometry.dispose();
                    mesh.material.dispose();
                    delete nodeMeshes[id];
                }
            }
            
            // Update/create edges - with memory pooling
            // Dispose old edges properly
            for (const line of Object.values(edgeLines)) {
                scene.remove(line);
                line.geometry.dispose();
                line.material.dispose();
            }
            edgeLines = {};
            
            // Limit edge rendering for performance (max 2000 edges visible)
            const maxEdges = Math.min(edges.length, 2000);
            const edgeStep = edges.length > maxEdges ? Math.floor(edges.length / maxEdges) : 1;
            
            // Shared material for all edges (memory optimization)
            const sharedEdgeMaterial = new THREE.LineBasicMaterial({
                color: 0x334455,
                transparent: true,
                opacity: 0.3
            });
            
            for (let i = 0; i < edges.length; i += edgeStep) {
                const edge = edges[i];
                const sourceNode = nodes.find(n => n.id === edge.source);
                const targetNode = nodes.find(n => n.id === edge.target);
                
                if (sourceNode && targetNode) {
                    const points = [
                        new THREE.Vector3(sourceNode.position?.x || 0, sourceNode.position?.y || 0, sourceNode.position?.z || 0),
                        new THREE.Vector3(targetNode.position?.x || 0, targetNode.position?.y || 0, targetNode.position?.z || 0)
                    ];
                    
                    const geometry = new THREE.BufferGeometry().setFromPoints(points);
                    const line = new THREE.Line(geometry, sharedEdgeMaterial);
                    scene.add(line);
                    edgeLines[edge.id] = line;
                }
            }
            
            // Update stats
            if (data.metrics) {
                updateStats(data.metrics);
            }
            
            // Update invariants
            if (data.invariants) {
                updateInvariants(data.invariants, data.violations || []);
            }
        }
        
        function updateStats(metrics) {
            document.getElementById('stat-nodes').textContent = metrics.node_count || 0;
            document.getElementById('stat-edges').textContent = metrics.edge_count || 0;
            document.getElementById('stat-mass').textContent = (metrics.total_mass || 0).toFixed(1);
            document.getElementById('stat-value').textContent = (metrics.total_value || 0).toFixed(0);
            document.getElementById('stat-trust').textContent = ((metrics.average_trust || 0) * 100).toFixed(0) + '%';
            document.getElementById('stat-temp').textContent = (metrics.average_temperature || 0).toFixed(2);
            
            const violations = metrics.invariant_violations || 0;
            const violationsEl = document.getElementById('stat-violations');
            violationsEl.textContent = violations;
            violationsEl.className = 'stat-value ' + (violations > 0 ? 'danger' : 'success');
            
            // Update bars
            document.getElementById('trust-bar').style.width = ((metrics.average_trust || 0) * 100) + '%';
            document.getElementById('entropy-bar').style.width = Math.min(100, (metrics.entropy || 0) * 10) + '%';
            document.getElementById('temp-bar').style.width = Math.min(100, (metrics.average_temperature || 0) * 20) + '%';
        }
        
        function updateInvariants(invariants, violations) {
            const list = document.getElementById('invariants-list');
            list.innerHTML = invariants.map(inv => {
                const isViolated = violations.some(v => v.invariant === inv.name);
                return `
                    <div class="invariant-item ${isViolated ? 'violated' : 'ok'}">
                        ${isViolated ? '❌' : '✅'} ${inv.name}
                    </div>
                `;
            }).join('');
        }
        
        async function checkAsymmetry() {
            try {
                const response = await fetch('/api/asymmetry');
                const data = await response.json();
                
                const asymEl = document.getElementById('stat-asymmetry');
                asymEl.textContent = (data.asymmetry_score * 100).toFixed(1) + '%';
                
                if (data.interpretation === 'emergence_possible') {
                    asymEl.className = 'stat-value success';
                } else if (data.interpretation === 'system_frozen') {
                    asymEl.className = 'stat-value danger';
                } else {
                    asymEl.className = 'stat-value warning';
                }
            } catch (error) {
                console.error('Failed to check asymmetry:', error);
            }
        }
        
        // Tab switching
        function switchTab(tabName) {
            // Update tab buttons
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            event.target.classList.add('active');
            
            // Update tab content
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            document.getElementById('tab-' + tabName).classList.add('active');
        }
        
        // Simulation speed
        function updateSimSpeed() {
            simSpeed = parseInt(document.getElementById('sim-speed').value);
            document.getElementById('sim-speed-value').textContent = simSpeed;
            
            // Update interval if auto-simulating
            if (autoSimulate) {
                clearInterval(autoSimInterval);
                autoSimInterval = setInterval(() => runSimulation(simSpeed), 100);
            }
        }
        
        // Generate custom size universe
        async function generateCustom(numNodes) {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('loading').innerHTML = `<div class="spinner"></div><div>Generating ${numNodes} nodes...</div>`;
            
            try {
                const response = await fetch('/api/galaxy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        num_users: numNodes,
                        num_transactions: numNodes * 3,
                        num_services: Math.max(3, Math.floor(numNodes / 50)),
                        enable_agent: true,
                        enable_entropy: true
                    })
                });
                const data = await response.json();
                updateVisualization(data.state);
                updateAgentUI(data.agent_enabled);
                await runSimulation(50);
            } catch (error) {
                console.error('Failed to generate:', error);
            }
            
            document.getElementById('loading').style.display = 'none';
        }
        
        // Physics presets
        function applyPhysicsPreset(preset) {
            const presets = {
                cold: { gravity: 0.05, repulsion: 50, spring: 0.02, damping: 0.98 },
                hot: { gravity: 0.3, repulsion: 200, spring: 0.1, damping: 0.7 },
                dense: { gravity: 0.8, repulsion: 30, spring: 0.15, damping: 0.95 },
                sparse: { gravity: 0.02, repulsion: 500, spring: 0.01, damping: 0.99 },
                chaotic: { gravity: 0.5, repulsion: 300, spring: 0.2, damping: 0.5 }
            };
            
            const p = presets[preset];
            if (!p) return;
            
            document.getElementById('gravity').value = p.gravity;
            document.getElementById('repulsion').value = p.repulsion;
            document.getElementById('spring').value = p.spring;
            document.getElementById('damping').value = p.damping;
            
            document.getElementById('gravity-value').textContent = p.gravity;
            document.getElementById('repulsion-value').textContent = p.repulsion;
            document.getElementById('spring-value').textContent = p.spring;
            document.getElementById('damping-value').textContent = p.damping;
            
            updatePhysics();
        }
        
        // Entropy controls
        function toggleEntropy() {
            entropyEnabled = !entropyEnabled;
            document.getElementById('entropy-toggle').classList.toggle('active', entropyEnabled);
        }
        
        async function updateEntropy() {
            const posNoise = parseFloat(document.getElementById('pos-noise').value);
            const velNoise = parseFloat(document.getElementById('vel-noise').value);
            const trustDecay = parseFloat(document.getElementById('trust-decay').value);
            const valueDecay = parseFloat(document.getElementById('value-decay').value);
            const activityRate = parseFloat(document.getElementById('activity-rate').value);
            
            document.getElementById('pos-noise-value').textContent = posNoise;
            document.getElementById('vel-noise-value').textContent = velNoise;
            document.getElementById('trust-decay-value').textContent = trustDecay;
            document.getElementById('value-decay-value').textContent = valueDecay;
            document.getElementById('activity-rate-value').textContent = activityRate;
            
            try {
                await fetch('/api/entropy/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        position_noise: posNoise,
                        velocity_noise: velNoise,
                        trust_decay: trustDecay,
                        value_decay: valueDecay,
                        activity_probability: activityRate
                    })
                });
            } catch (error) {
                console.error('Failed to update entropy:', error);
            }
        }
        
        async function perturbation() {
            const magnitude = parseFloat(document.getElementById('perturb-mag')?.value || 1.0);
            try {
                const response = await fetch(`/api/entropy/perturbation?magnitude=${magnitude}`, { method: 'POST' });
                const data = await response.json();
                console.log('Perturbation event:', data.event);
                await runSimulation(10);
            } catch (error) {
                console.error('Perturbation failed:', error);
            }
        }
        
        // Agent controls
        let agentActive = false;
        
        async function spawnAgent() {
            const budget = parseFloat(document.getElementById('agent-budget').value);
            const actionRate = parseFloat(document.getElementById('agent-action').value);
            
            try {
                const response = await fetch(`/api/agent/spawn?budget=${budget}&action_probability=${actionRate}`, { method: 'POST' });
                const data = await response.json();
                
                console.log('Spawn agent response:', data);
                
                if (data.success) {
                    agentActive = true;
                    updateAgentUI(true);
                    updateAgentDisplay(data.agent);
                    document.getElementById('agent-toggle').classList.add('active');
                } else {
                    alert('Failed to spawn agent: ' + (data.message || 'Unknown error'));
                }
            } catch (error) {
                console.error('Failed to spawn agent:', error);
                alert('Failed to spawn agent: ' + error.message);
            }
        }
        
        async function agentStep() {
            try {
                const response = await fetch('/api/agent/step', { method: 'POST' });
                const data = await response.json();
                
                if (data.success) {
                    updateAgentDisplay(data.status);
                    await loadState();
                }
            } catch (error) {
                console.error('Agent step failed:', error);
            }
        }
        
        async function killAgent() {
            try {
                await fetch('/api/agent/kill', { method: 'POST' });
                agentActive = false;
                updateAgentUI(false);
                document.getElementById('agent-toggle').classList.remove('active');
            } catch (error) {
                console.error('Failed to kill agent:', error);
            }
        }
        
        async function spawnMultipleAgents() {
            const count = parseInt(document.getElementById('multi-agent-count').value);
            const budget = parseFloat(document.getElementById('agent-budget').value);
            const actionRate = parseFloat(document.getElementById('agent-action').value);
            
            try {
                const response = await fetch(`/api/agents/spawn?count=${count}&budget=${budget}&action_probability=${actionRate}`, { method: 'POST' });
                const data = await response.json();
                
                console.log('Spawn multiple agents response:', data);
                
                if (data.success) {
                    alert(`Spawned ${data.spawned} agents. Total: ${data.total_agents}`);
                    document.getElementById('agent-toggle').classList.add('active');
